# Copy this file to .env and fill in your own values:
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# .env is gitignored. Never commit it, paste it into chats or issues, or show it to a coding agent.
# Every variable here is read by the Node server only. None is sent to the browser,
# and none may be renamed with a VITE_ prefix (Vite would inline it into the client bundle).

# --- Required -----------------------------------------------------------------
# Server only. Create a key in a dedicated OpenAI project for this app.
OPENAI_API_KEY=replace-with-your-key

# --- Models -------------------------------------------------------------------
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Ava's voice only (the default presenter). Theo (cedar) and Mira (coral) always use their own
# voices, set in shared/src/personas.ts. If you change this, rerun npm run voices:samples so Ava's
# preview clip matches.
OPENAI_REALTIME_VOICE=marin
# Text model for backup voice (/api/chat) and the eval fallback.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Judge model for npm run eval. Use a different model family from the agent if you can.
EVAL_JUDGE_MODEL=gpt-4.1

# --- Server -------------------------------------------------------------------
PORT=8787
RATE_LIMIT_PER_MIN=10

# --- Hosted demo limits (leave empty locally = no limit) ----------------------
SESSION_MAX_MINUTES=
MAX_CONCURRENT_SESSIONS=
DAILY_SESSIONS_PER_IP=
DAILY_SESSIONS_GLOBAL=
# 1 = open a server sideband per call (time limit, config guard). Hosted only.
SIDEBAND=0
# 1 = read X-Forwarded-For for per-IP limits. Set automatically on Render and Railway.
TRUST_PROXY=
# Shown in limit and "paused" messages.
PUBLIC_REPO_URL=

# --- Bot gate (hosted only; leave empty to disable) ----------------------------
# The site key is public and served to the browser by /api/health.
TURNSTILE_SITE_KEY=
# Server only.
TURNSTILE_SECRET_KEY=

# --- Stats (leave empty to disable /api/stats) --------------------------------
# Server only. Bearer token for GET /api/stats.
STATS_TOKEN=
