{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "OpenAI API key",
            "pattern": "/\\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}/"
          },
          {
            "name": "OpenAI ephemeral client secret",
            "pattern": "/\\bek_[A-Za-z0-9_-]{20,}/"
          },
          {
            "name": "Secret assigned in an env-style line",
            "pattern": "/^\\s*(?:OPENAI_API_KEY|TURNSTILE_SECRET_KEY|STATS_TOKEN)=(?!replace-with)\\S{8,}/m"
          }
        ],
        "allows": ["/ek_test_[A-Za-z0-9_]*/", "/sk-test[A-Za-z0-9_-]*/"]
      }
    }
  ]
}
