{
  "name": "ava-voice-presenter",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:e2e": "concurrently -k \"npm run dev -w server\" \"npm run dev:e2e -w web\"",
    "build": "npm run build -w web && npm run build -w server && node scripts/check-bundle-secrets.mjs",
    "start": "node server/dist/index.js",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "eval": "node --env-file-if-exists=.env --import tsx eval/run.ts",
    "voices:samples": "node --env-file-if-exists=.env --import tsx eval/voiceSamples.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "secrets:scan": "secretlint --maskSecrets \"**/*\"",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@secretlint/secretlint-rule-pattern": "^9.3.4",
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "secretlint": "^9.0.0",
    "simple-git-hooks": "^2.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
